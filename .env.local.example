# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub
GITHUB_TOKEN=

# Agent runners
OPENCODE_GO_KEY=

# Loop limits
MAX_REVIEW_LOOPS=3
MAX_TEST_LOOPS=3

# Web search MCP (Tavily) — https://tavily.com
TAVILY_API_KEY=

# ──────────────────────────────────────────────
# CM-Pipeline (Checkmarx auto-scan & auto-fix)
# ──────────────────────────────────────────────

# Database for pg-boss queue (cm-worker)
# Use the same Supabase Postgres connection string:
# postgresql://postgres:<password>@<host>:6543/postgres
CM_DATABASE_URL=

# Adapter selection (dev = mock/stub, prod = checkmarx/claude)
# CM_SCAN_PROVIDER=mock    | checkmarx
# CM_AGENT_RUNNER=stub     | claude

# Real Checkmarx One CLI credentials (required when CM_SCAN_PROVIDER=checkmarx)
# Get these from your Checkmarx tenant admin
CX_BASE_URI=
CX_TENANT=
CX_APIKEY=
