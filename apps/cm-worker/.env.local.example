# ──────────────────────────────────────────────
# CM-Worker — Checkmarx Auto-Scan & Auto-Fix
# ──────────────────────────────────────────────
# Copy to .env.local and fill in values.
# The worker reads .env.local automatically when started via `pnpm dev`.

# Database connection string (Supabase Postgres) for pg-boss queue.
# Use pooled connection: postgresql://postgres:<password>@<host>:6543/postgres
CM_DATABASE_URL=

# Supabase service-role credentials (for reading/writing cm_* tables)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub token (for opening PRs on fixed repos)
GITHUB_TOKEN=

# ── Adapter selection ────────────────────────
# Dev/test:  CM_SCAN_PROVIDER=mock   CM_AGENT_RUNNER=stub
# Production: CM_SCAN_PROVIDER=checkmarx  CM_AGENT_RUNNER=claude
CM_SCAN_PROVIDER=mock
CM_AGENT_RUNNER=stub

# ── Real Checkmarx One CLI ──────────────────
# Only needed when CM_SCAN_PROVIDER=checkmarx
# CX_BASE_URI=https://eu.checkmarx.net
# CX_TENANT=my-tenant
# CX_APIKEY=
# Optional: enables getLatestScan() to reuse a recent scheduled scan instead
# of always triggering a fresh cx scan create. Safe to omit — falls back to
# a fresh scan automatically when not set.
# CX_BASE_AUTH_URI=https://eu.iam.checkmarx.net
# CX_IAM_REALM=my-realm  # only needed if it differs from CX_TENANT

# ── Real agent runner ───────────────────────
# Only needed when CM_AGENT_RUNNER=claude
# Ensure `claude` or `opencode` CLI is installed and on PATH.
