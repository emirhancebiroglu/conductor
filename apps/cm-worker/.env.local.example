# ──────────────────────────────────────────────
# CM-Worker — Checkmarx Auto-Scan & Auto-Fix
# ──────────────────────────────────────────────
# Copy to .env.local and fill in values.
# The worker reads .env.local automatically when started via `pnpm dev`.

# Database connection string (Supabase Postgres) for pg-boss queue.
# Use pooled connection: postgresql://postgres:<password>@<host>:6543/postgres
CM_DATABASE_URL=

# Supabase service-role credentials (for reading/writing cm_* tables)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub token (for opening PRs on fixed repos)
GITHUB_TOKEN=

# ── Adapter selection ────────────────────────
# Dev/test:  CM_SCAN_PROVIDER=mock   CM_AGENT_RUNNER=stub
# Production: CM_SCAN_PROVIDER=checkmarx  CM_AGENT_RUNNER=claude
CM_SCAN_PROVIDER=mock
CM_AGENT_RUNNER=stub

# ── Real Checkmarx One CLI ──────────────────
# Only needed when CM_SCAN_PROVIDER=checkmarx
# CX_BASE_URI=https://eu.checkmarx.net
# CX_TENANT=my-tenant
# CX_APIKEY=
# Optional: enables getLatestScan() to reuse a recent scheduled scan instead
# of always triggering a fresh cx scan create. Safe to omit — falls back to
# a fresh scan automatically when not set.
# CX_BASE_AUTH_URI=https://eu.iam.checkmarx.net
# CX_IAM_REALM=my-realm  # only needed if it differs from CX_TENANT

# ── Persistent build cache ──────────────────
# Recommended: shared Maven/npm cache across all cloned repos so
# frontend-maven-plugin doesn't re-download node/npm from scratch on every
# fresh clone. Optional but strongly recommended for reliability + speed.
# MAVEN_OPTS=-Dmaven.repo.local=/path/to/cache/m2
# npm_config_cache=/path/to/cache/npm

# ── Agent tracing (Arize Phoenix, local) ─────
# Run `phoenix serve` (pip install arize-phoenix) separately — UI at
# http://localhost:6006, OTLP gRPC collector at localhost:4317.
#
# Claude Code (native support):
# CLAUDE_CODE_ENABLE_TELEMETRY=1
# CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1  # required for traces specifically, not just metrics/logs
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_RESOURCE_ATTRIBUTES=service.name=cm-worker
#
# opencode: its own "experimental.openTelemetry" config flag does NOT actually
# export anywhere (confirmed empirically, matches an open opencode feature
# request for native OTLP export) — needs the community plugin instead, added
# to opencode.json's "plugin" array: @devtheops/opencode-plugin-otel
# OPENCODE_ENABLE_TELEMETRY=1
# OPENCODE_OTLP_ENDPOINT=http://localhost:4317
# OPENCODE_OTLP_PROTOCOL=grpc

# ── Real agent runner ───────────────────────
# Only needed when CM_AGENT_RUNNER=claude
# Ensure `claude` or `opencode` CLI is installed and on PATH.
