{
  "name": "@conductor/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env.local watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file=.env.local src/smoke-test.ts",
    "backtest": "chcp 65001 >nul 2>&1 & tsx --env-file=.env.local src/backtest/run-backtest.ts",
    "backtest:dry": "chcp 65001 >nul 2>&1 & tsx --env-file=.env.local src/backtest/run-backtest.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@conductor/agents": "workspace:*",
    "@conductor/core": "workspace:*",
    "@conductor/github": "workspace:*",
    "@supabase/supabase-js": "^2.106.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@conductor/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
