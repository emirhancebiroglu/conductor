{
  "name": "conductor",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm --filter dashboard build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter dashboard test:e2e",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter dashboard db:push",
    "typecheck": "pnpm -r typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
